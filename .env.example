# Supabase project URL (public)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase anon / publishable key (public — safe to expose in the frontend bundle)
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# Optional override for the tap_scores table name. Defaults to the Gogi-prefixed
# table `usr_nmexs7bytxq2_tap_scores`. Change this only if you create the table
# under a different name (e.g. in a different Supabase project).
# VITE_TAP_SCORES_TABLE=usr_nmexs7bytxq2_tap_scores
